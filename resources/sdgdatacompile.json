{
  "database": {
    "name": "sdgHackathon",
    "version": "1.0",
    "description": "Unified relational schema for all 17 UN Sustainable Development Goals (SDGs). Designed for MySQL using camelCase naming conventions with interconnected datasets."
  },
  "sharedTables": [
    {
      "tableName": "country",
      "primaryKey": "countryId",
      "description": "Master table containing countries.",
      "fields": [
        {
          "name": "countryId",
          "type": "INT AUTO_INCREMENT",
          "nullable": false,
          "description": "Primary key."
        },
        {
          "name": "isoCode",
          "type": "CHAR(3)",
          "nullable": false,
          "description": "ISO-3166 country code."
        },
        {
          "name": "countryName",
          "type": "VARCHAR(120)",
          "nullable": false,
          "description": "Official country name."
        },
        {
          "name": "region",
          "type": "VARCHAR(80)",
          "nullable": false,
          "description": "Geographical region."
        },
        {
          "name": "incomeGroup",
          "type": "VARCHAR(50)",
          "nullable": false,
          "description": "World Bank income classification."
        }
      ]
    },
    {
      "tableName": "location",
      "primaryKey": "locationId",
      "foreignKeys": [
        {
          "field": "countryId",
          "references": "country.countryId"
        }
      ],
      "description": "Administrative location hierarchy.",
      "fields": [
        {
          "name": "locationId",
          "type": "INT AUTO_INCREMENT",
          "nullable": false,
          "description": "Primary key."
        },
        {
          "name": "countryId",
          "type": "INT",
          "nullable": false,
          "description": "Country reference."
        },
        {
          "name": "stateName",
          "type": "VARCHAR(120)",
          "nullable": false,
          "description": "State or province."
        },
        {
          "name": "districtName",
          "type": "VARCHAR(120)",
          "nullable": true,
          "description": "District or county."
        },
        {
          "name": "cityName",
          "type": "VARCHAR(120)",
          "nullable": true,
          "description": "City or municipality."
        },
        {
          "name": "latitude",
          "type": "DECIMAL(10,7)",
          "nullable": true,
          "description": "Latitude."
        },
        {
          "name": "longitude",
          "type": "DECIMAL(10,7)",
          "nullable": true,
          "description": "Longitude."
        }
      ]
    },
    {
      "tableName": "yearDimension",
      "primaryKey": "yearId",
      "description": "Reporting year dimension.",
      "fields": [
        {
          "name": "yearId",
          "type": "INT AUTO_INCREMENT",
          "nullable": false,
          "description": "Primary key."
        },
        {
          "name": "reportYear",
          "type": "YEAR",
          "nullable": false,
          "description": "Reporting year."
        }
      ]
    }
  ],
